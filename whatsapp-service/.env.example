# Base URL of your Laravel app (for webhook callbacks). Must be reachable from this Node process.
# Same machine: use http://humano.test/webhook/whatsapp-local or http://127.0.0.1/webhook/whatsapp-local
LARAVEL_WEBHOOK_URL=http://humano.test/webhook/whatsapp-local
# Optional: base URL for /chat/whatsapp-linked callback. Set to your app URL (e.g. https://humano.test) when
# LARAVEL_WEBHOOK_URL uses 127.0.0.1/localhost but the app is served by hostname (e.g. Herd), so the callback hits the same app.
# LARAVEL_APP_URL=https://humano.test
# Optional: set in Laravel .env as WHATSAPP_LOCAL_WEBHOOK_SECRET and pass here
WEBHOOK_SECRET=
# Port for this service (use different port per site if staging + production on same server, e.g. 3001 for staging)
PORT=3000
# Directory for Baileys auth files (persisted session)
AUTH_DIR=./auth
