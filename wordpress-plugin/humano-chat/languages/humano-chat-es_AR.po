msgid "Humano Chat"
msgstr "Humano Chat"

msgid "Humano Base URL"
msgstr "URL base de Humano"

msgid "Your Humano instance URL (no trailing slash)."
msgstr "URL de tu instancia de Humano (sin barra final)."

msgid "API Token"
msgstr "Token de API"

msgid "Team API token from Humano: Team Settings → API Tokens. See your Humano /help for details."
msgstr "Token de equipo desde Humano: Ajustes del equipo → Tokens API. Consulta /help en Humano para más detalles."

msgid "Prompt key (optional)"
msgstr "Clave de prompt (opcional)"

msgid "Leave empty to use the assistant router. Set a key to force a specific prompt flow."
msgstr "Dejar vacío para usar el enrutador del asistente. Indica una clave para forzar un flujo concreto."

msgid "Floating widget"
msgstr "Widget flotante"

msgid "Show floating chat button on all front-end pages"
msgstr "Mostrar botón de chat flotante en todas las páginas"

msgid "Otherwise use the shortcode [humano_chat] where you want the chat."
msgstr "Si no, usa el shortcode [humano_chat] donde quieras el chat."

msgid "SSL verification"
msgstr "Verificación SSL"

msgid "Verify SSL certificate when calling Humano (recommended)"
msgstr "Verificar certificado SSL al llamar a Humano (recomendado)"

msgid "Uncheck only for local development (e.g. .test, self-signed certs). Fixes \"cURL error 60: unable to get local issuer certificate\". Do not disable in production."
msgstr "Desmarcar solo en desarrollo local (ej. .test, certificados autofirmados). Soluciona el error cURL 60. No desactivar en producción."

msgid "Getting your API token"
msgstr "Obtener tu token de API"

msgid "Log in to Humano, go to Team Settings → API Tokens, generate a token and paste it above. Full documentation: open the Help section in Humano (e.g. /help and API Authentication)."
msgstr "Inicia sesión en Humano, ve a Ajustes del equipo → Tokens API, genera un token y pégalo arriba. Documentación: sección Ayuda en Humano (/help y Autenticación API)."

msgid "Humano Chat is not configured. Add Base URL and API Token in Settings → Humano Chat."
msgstr "Humano Chat no está configurado. Añade URL base y Token de API en Ajustes → Humano Chat."

msgid "Network error: "
msgstr "Error de red: "

msgid "Invalid or expired API token. Check your token in Humano (Team Settings → API Tokens) and in Settings → Humano Chat."
msgstr "Token de API inválido o caducado. Revisa el token en Humano (Ajustes del equipo → Tokens API) y en Ajustes → Humano Chat."

msgid "Too many requests. Please wait a moment and try again."
msgstr "Demasiadas solicitudes. Espera un momento e inténtalo de nuevo."

msgid "Humano service is temporarily unavailable. Try again later."
msgstr "El servicio Humano no está disponible. Vuelve a intentarlo más tarde."

msgid "Unexpected response from Humano."
msgstr "Respuesta inesperada de Humano."

msgid "Invalid response from Humano."
msgstr "Respuesta inválida de Humano."

msgid "Send"
msgstr "Enviar"

msgid "Type your message..."
msgstr "Escribe tu mensaje..."

msgid "Thinking..."
msgstr "Pensando..."

msgid "Something went wrong. Try again."
msgstr "Algo salió mal. Inténtalo de nuevo."

msgid "Open chat"
msgstr "Abrir chat"

msgid "Close chat"
msgstr "Cerrar chat"

msgid "Message is required."
msgstr "El mensaje es obligatorio."

msgid "Unknown error."
msgstr "Error desconocido."
