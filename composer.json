{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "chillerlan/php-qrcode": "^5.0",
    "darryldecode/cart": "^4.2",
    "fakerphp/faker": "^1.23",
    "google/apiclient": "^2.19",
    "guzzlehttp/guzzle": "^7.9",
    "idoneo/humano-academy": "dev-main",
    "jd-dotlogics/laravel-grapesjs": "3.4.1",
    "laravel/ai": "^0.2",
    "laravel/cashier": "^15.0",
    "laravel/framework": "^12.0",
    "laravel/jetstream": "^5.0",
    "laravel/sanctum": "^4.0",
    "laravel/telescope": "^5.15",
    "laravel/tinker": "^2.8",
    "livewire/livewire": "^4.0",
    "nyholm/psr7": "^1.8",
    "php-ffmpeg/php-ffmpeg": "^1.4",
    "sbsaga/toon": "^1.2",
    "sentry/sentry-laravel": "^4.20",
    "spatie/image": "^3.9",
    "spatie/laravel-analytics": "^5.6",
    "spatie/laravel-google-calendar": "^3.8",
    "spatie/laravel-medialibrary": "^11.13",
    "spatie/laravel-permission": "^6.20",
    "spatie/laravel-settings": "^3.7",
    "spatie/laravel-tags": "^4.10",
    "squareetlabs/laravel-verifactu": "^1.0",
    "symfony/http-client": "^7.3",
    "symfony/var-dumper": "*",
    "tijsverkoyen/css-to-inline-styles": "^2.3",
    "twilio/sdk": "^8.2",
    "webklex/laravel-imap": "*",
    "yajra/laravel-datatables": "^12.0",
    "yajra/laravel-datatables-oracle": "^12.0"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.14",
    "beyondcode/laravel-query-detector": "^2.1",
    "laravel-lang/common": "^6.4",
    "laravel/boost": "^1.3",
    "laravel/pint": "^1.22",
    "laravel/sail": "^1.25",
    "mockery/mockery": "^1.4.4",
    "phpunit/phpunit": "^10.1",
    "pixinvent/vuexy-laravel-bootstrap-jetstream": "dev-mix",
    "spatie/laravel-ignition": "^2.0",
    "wikimedia/composer-merge-plugin": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/Helpers.php",
      "app/Helpers/FileHelpers.php",
      "app/Helpers/WHMHelper.php",
      "app/Helpers/TranslationHelper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    },
    "merge-plugin": {
      "include": [
        "composer.local.json"
      ],
      "recurse": true,
      "replace": false,
      "ignore-duplicates": true
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "wikimedia/composer-merge-plugin": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": {}
}
