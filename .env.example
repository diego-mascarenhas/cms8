# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Humano
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set false for demo/presentation (local with APP_DEBUG=true still loads Debugbar unless disabled)
DEBUGBAR_ENABLED=false
APP_URL=http://localhost
APP_LOCALE=es_ES
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

# Daily dashboard performance micro-insight (Laravel AI / Anthropic). Set false to use short static fallbacks only.
# DAILY_PERFORMANCE_INSIGHT_USE_LLM=true

# Guest "/" redirect (all environments; route wins over path if both set). Empty = login.
# PUBLIC_HOME_ROUTE=humano
# PUBLIC_HOME_ROUTE=wapify
# PUBLIC_HOME_ROUTE=slash
# PUBLIC_HOME_PATH=/inicio
# PUBLIC_HOME_PATH=/slash
# PUBLIC_HOME_ROUTE=
# PUBLIC_HOME_PATH=

# Auth pages: true hides the left illustration panel (login, register, password reset, etc.)
AUTH_MINIMAL_LAYOUT=false

# Auth pages: true shows the brand logo on login, register, verify email, confirm password, etc.
AUTH_SHOW_LOGO=false

# Optional: custom logo paths (defaults under public/assets/)
# APP_LOGO_PATH=assets/logo.png
# APP_LOGO_PATH_DARK=assets/logo-dark.svg
# APP_LOGO_PATH_LIGHT=assets/logo-light.svg
# APP_LOGO_PATH_ISO=assets/logo-iso.svg
# APP_LOGO_PATH_ISO_DARK=assets/logo-iso-dark.svg
# APP_LOGO_PATH_ISO_LIGHT=assets/logo-iso-light.svg
# APP_LOGO_FALLBACK=assets/logo.svg
# APP_LOGO_ISO_FALLBACK=assets/logo-iso.svg
# Optional budget/quote logo override (empty = use APP_LOGO_PATH_LIGHT / logo-light.svg)
# APP_LOGO_BUDGET_PATH=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SHOW_CONSOLE_OUTPUT=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PHPUnit / automated tests always use sqlite in-memory (see phpunit.xml and tests/CreatesApplication.php).
# They do not use these MySQL settings, so running the test suite will not wipe this database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_FOREIGN_KEYS=true
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/database
# MYSQL_ATTR_SSL_CA=

# Legacy database (optional)
DB_LEGACY_CONNECTION=mysql
DB_LEGACY_HOST=
DB_LEGACY_PORT=
DB_LEGACY_DATABASE=
DB_LEGACY_USERNAME=
DB_LEGACY_PASSWORD=
DB_LEGACY_SOCKET=

# Production read-only connection (local only). Set ALLOW_PROD_READ_TOGGLE=true to show the navbar switch.
# Use a DB user with SELECT-only on production. Never enable ALLOW_PROD_READ_TOGGLE outside local.
# Also used by: ./scripts/export-pgsql-from-forge.sh (direct pg_dump mode)
# ALLOW_PROD_READ_TOGGLE=false
# DB_PROD_READ_CONNECTION=pgsql
# DB_PROD_READ_HOST=
# DB_PROD_READ_PORT=5432
# DB_PROD_READ_DATABASE=
# DB_PROD_READ_USERNAME=
# DB_PROD_READ_PASSWORD=
# DB_PROD_READ_SCHEMA=public
# DB_PROD_READ_SSLMODE=prefer
# DB_PROD_READ_URL=

# Optional: Forge VPS dump via SSH (default for scripts/export-pgsql-from-forge.sh)
# SSH host defaults to DB_PROD_READ_HOST when FORGE_SSH_HOST is empty.
# FORGE_SSH_HOST=geri.revisionalpha.cloud
# FORGE_SSH_USER=forge
# FORGE_SSH_PORT=22
# FORGE_SITE_PATH=/home/forge/humano.app
# FORGE_SSH_IDENTITY=~/.ssh/id_rsa

# -----------------------------------------------------------------------------
# Cache, Queue, Session
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_STORE=file
# GET /api/team/contents list cache. -1 (default) = until content changes (rememberForever + bump). 0 = off. >0 = TTL seconds for orphan keys after bumps.
# TEAM_CONTENTS_INDEX_CACHE_TTL=-1
FILESYSTEM_DISK=local

# Private unprocessed originals (content covers, future features). Not in storage/app/public.
# Omit to use the default: storage/app/originals. Same disk name if you later use s3 here.
# ORIGINALS_PATH=/var/humano/storage/app/originals

QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (SMTP) – Solo necesario si NO usas EmailJS en Prospection (o para otros mails de la app).
# Prospection en modo standalone envía el correo de acceso con EmailJS desde el frontend; no usa esto.
# Credenciales: MAIL_USERNAME, MAIL_PASSWORD.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Notification email for system reports and alerts
# -----------------------------------------------------------------------------
NOTIFICATION_EMAIL=

MAIL_MAILER=smtp
MAIL_HOST=relay.outboundspamprotection.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
# MAIL_LOG_CHANNEL=

# -----------------------------------------------------------------------------
# IMAP / Mailbox (optional)
# -----------------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_TIMEOUT=60
IMAP_DEFAULT_ACCOUNT=default

MAILBOX_DRIVER=log
MAILBOX_HOST=
MAILBOX_PORT=
MAILBOX_PROTOCOL=
MAILBOX_ENCRYPTION=
MAILBOX_VALIDATE_CERT=
MAILBOX_USERNAME=
MAILBOX_PASSWORD=
MAILBOX_TIMEOUT=
MAILBOX_DEFAULT_ACCOUNT=

# -----------------------------------------------------------------------------
# MailBaby / Email API
# -----------------------------------------------------------------------------
MAILBABY_API_KEY=
MAILBABY_API_URL=https://api.mailbaby.net
MAILBABY_WEBHOOK_SECRET=
MAILBABY_ENABLED=false

# Email provider (smtp, mailbaby, etc.) and fallback
EMAIL_PROVIDER=smtp
EMAIL_FALLBACK_TO_SMTP=true
EMAIL_DELIVERIES_PER_CAMPAIGN_RUN=30
EMAIL_DELIVERIES_PER_SEND_RUN=20
EMAIL_DELAY_BASE_MINUTES=1
EMAIL_DELAY_RANDOM_SECONDS=60

# Mail API (mailer config)
MAIL_API_KEY=
MAIL_API_DOMAIN=

# Mailgun / SendGrid (if used by emailer)
# MAILGUN_DOMAIN=
# MAILGUN_SECRET=
# MAILGUN_ENDPOINT=api.mailgun.net
# SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# Emailer (campaigns; see config/emailer.php for full list)
# -----------------------------------------------------------------------------
EMAILER_PROVIDER=smtp
EMAILER_FALLBACK_TO_SMTP=true
EMAILER_QUEUE=emailer
EMAILER_DELAY_BASE_MINUTES=5
EMAILER_DELAY_RANDOM_SECONDS=120
EMAILER_FROM_ADDRESS=
EMAILER_FROM_NAME=
EMAILER_TRACKING_ENABLED=true
EMAILER_ROUTE_PREFIX=emailer
EMAIL_DELIVERIES_PER_SEND_RUN=20
EMAIL_DELIVERIES_PER_CAMPAIGN_RUN=30

# -----------------------------------------------------------------------------
# Broadcasting / Pusher
# -----------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ABLY_KEY=

# -----------------------------------------------------------------------------
# AWS / S3
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Stripe / Cashier
# -----------------------------------------------------------------------------
# Default Stripe account. Used for all categories when per-category keys are not set (see below).
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE=300

# -----------------------------------------------------------------------------
# Mercado Pago
# -----------------------------------------------------------------------------
# Scheduled settlement-payer enrich (routes/console.php). Set false to pause without removing the schedule.
# Manual: php artisan mercadopago:enrich-settlement-payers ... still works.
MERCADOPAGO_SETTLEMENT_ENRICH_SCHEDULE_ENABLED=true

# All products (Assistant, Mailer, Mentoring, Hosting, Prospecting) use STRIPE_KEY / STRIPE_SECRET above.
# Per-category STRIPE_*_SECRET keys are ignored.
# All product/price IDs (Mailer, Prospecting, Mentoring, Hosting) are managed in subscription_products (admin UI). Sync with: php artisan products:sync [--category=mailer|prospecting|...]
# STRIPE_MENTORING_SECRET=
# STRIPE_MENTORING_KEY=
# STRIPE_MENTORING_WEBHOOK_SECRET=
# STRIPE_MAILER_SECRET=
# STRIPE_MAILER_KEY=
# STRIPE_MAILER_WEBHOOK_SECRET=
# STRIPE_PROSPECTING_SECRET=
# STRIPE_PROSPECTING_KEY=
# STRIPE_PROSPECTING_WEBHOOK_SECRET=
# STRIPE_HOSTING_SECRET=
# STRIPE_HOSTING_KEY=
# STRIPE_HOSTING_WEBHOOK_SECRET=

# Public pricing page (/pricing): Stripe Payment Links (promo code is not added to URLs; users type it in Stripe if they have it)
# Teams that skip checkout and the app trial (treated as paid). Default 1,2,3.
# CMS8_PLAN_ACCESS_TEAM_IDS=1,2,3
# HUMANO_PRICING_COUPON_CODE=SOYAMIGO
# Payment Link affiliates: HUMANO_PRICING_PAYMENT_LINK_AFFILIATE_CUSTOM_FIELD_KEYS=referente,affiliate (comma-separated). If the field is empty, use ?client_reference_id=cus_REFERRER_STRIPE_ID on the link.
# HUMANO_AFFILIATE_COMMISSION_PERCENT=40
# HUMANO_PRICING_ASSISTANT_CHECKOUT_AVAILABLE=true
# HUMANO_PRICING_BUSINESS_CHECKOUT_AVAILABLE=false
# HUMANO_PRICING_MENTOR_CHECKOUT_AVAILABLE=false
# HUMANO_PRICING_ASSISTANT_CHECKOUT_URL=https://buy.stripe.com/...
# HUMANO_PRICING_ASSISTANT_CHECKOUT_URL_YEARLY=https://buy.stripe.com/...
# HUMANO_PRICING_ASSISTANT_STRIPE_PRODUCT_ID=prod_V8JgY0BNt1q78v
# HUMANO_PRICING_ASSISTANT_PRICE_MONTHLY_ID=price_1U832rRwN51ygFdeO4vRvsls
# HUMANO_PRICING_ASSISTANT_PRICE_YEARLY_ID=price_1U832sRwN51ygFdepkVDBeFy
# HUMANO_PRICING_BUSINESS_CHECKOUT_URL=https://buy.stripe.com/6oU14nfxjabIbPUbuR43S04
# HUMANO_PRICING_BUSINESS_CHECKOUT_URL_YEARLY=https://buy.stripe.com/...
# HUMANO_PRICING_BUSINESS_STRIPE_PRODUCT_ID=prod_UUoHz602tHBY8b
# HUMANO_PRICING_BUSINESS_PRICE_MONTHLY_ID=price_1TVoebGelYN536DrLAOm6k90
# HUMANO_PRICING_BUSINESS_PRICE_YEARLY_ID=price_1TVof6GelYN536DrAaThyVzr
# (Stripe amounts for those prices: 299€/mes, 2990€/año — display text: monthly_amount/yearly_amount in config/humano_pricing.php)
# HUMANO_PRICING_MENTOR_CHECKOUT_URL=
# HUMANO_PRICING_MENTOR_STRIPE_PRODUCT_ID=
# HUMANO_PRICING_MENTOR_PRICE_MONTHLY_ID=
# HUMANO_PRICING_MENTOR_PRICE_YEARLY_ID=
# Mailer SPA plans (not shown on public /pricing). Override Stripe IDs in production.
# HUMANO_PRICING_MAILER_BASIC_STRIPE_PRODUCT_ID=prod_xxx
# HUMANO_PRICING_MAILER_BASIC_PRICE_MONTHLY_ID=price_xxx
# HUMANO_PRICING_MAILER_BASIC_MONTHLY_AMOUNT=15.99
# HUMANO_PRICING_MAILER_FOUNDATION_STRIPE_PRODUCT_ID=prod_xxx
# HUMANO_PRICING_MAILER_FOUNDATION_PRICE_MONTHLY_ID=price_xxx
# HUMANO_PRICING_MAILER_FOUNDATION_MONTHLY_AMOUNT=35.99
# HUMANO_PRICING_MAILER_SCALE_STRIPE_PRODUCT_ID=prod_xxx
# HUMANO_PRICING_MAILER_SCALE_PRICE_MONTHLY_ID=price_xxx
# HUMANO_PRICING_MAILER_SCALE_MONTHLY_AMOUNT=119.99

# App catalogs (Shop / Ads / Projects). Config defaults are Stripe test IDs.
# On production, override with the live IDs from `php artisan humano-pricing:publish-stripe --live`.
# HUMANO_PRICING_SHOP_BASIC_STRIPE_PRODUCT_ID=prod_V89CZ43gVIPvQg
# HUMANO_PRICING_SHOP_BASIC_PRICE_MONTHLY_ID=price_1U7suSRwN51ygFdeIzFcpTd0
# HUMANO_PRICING_SHOP_BASIC_PRICE_YEARLY_ID=price_1U8cY9RwN51ygFdeLbP98VNT
# HUMANO_PRICING_SHOP_BASIC_MONTHLY_AMOUNT=19
# HUMANO_PRICING_SHOP_BASIC_YEARLY_AMOUNT=190
# HUMANO_PRICING_SHOP_PREMIUM_STRIPE_PRODUCT_ID=prod_V89CmotlVusNGW
# HUMANO_PRICING_SHOP_PREMIUM_PRICE_MONTHLY_ID=price_1U7suTRwN51ygFdebYrQlubO
# HUMANO_PRICING_SHOP_PREMIUM_PRICE_YEARLY_ID=price_1U8cYARwN51ygFdevPvhSfj4
# HUMANO_PRICING_SHOP_PREMIUM_MONTHLY_AMOUNT=39
# HUMANO_PRICING_SHOP_PREMIUM_YEARLY_AMOUNT=390
# HUMANO_PRICING_SHOP_PROFESIONAL_STRIPE_PRODUCT_ID=prod_V89CuPC7sK1GOK
# HUMANO_PRICING_SHOP_PROFESIONAL_PRICE_MONTHLY_ID=price_1U7suVRwN51ygFdeju92Q3s0
# HUMANO_PRICING_SHOP_PROFESIONAL_PRICE_YEARLY_ID=price_1U8cYBRwN51ygFde7olTT4U0
# HUMANO_PRICING_SHOP_PROFESIONAL_MONTHLY_AMOUNT=79
# HUMANO_PRICING_SHOP_PROFESIONAL_YEARLY_AMOUNT=790
# HUMANO_PRICING_ADS_STRIPE_PRODUCT_ID=prod_V89CiGe1zBJrm4
# HUMANO_PRICING_ADS_PRICE_MONTHLY_ID=price_1U7suWRwN51ygFdeV0sMB6NR
# HUMANO_PRICING_ADS_PRICE_YEARLY_ID=price_1U8cYBRwN51ygFdeKV6mdxVY
# HUMANO_PRICING_ADS_MONTHLY_AMOUNT=49
# HUMANO_PRICING_ADS_YEARLY_AMOUNT=490
# HUMANO_PRICING_PROJECTS_STRIPE_PRODUCT_ID=prod_V89ClZnOudl5Ag
# HUMANO_PRICING_PROJECTS_PRICE_MONTHLY_ID=price_1U7suXRwN51ygFdeRFDxdIXs
# HUMANO_PRICING_PROJECTS_PRICE_YEARLY_ID=price_1U8cYCRwN51ygFdeYjaPphR0
# HUMANO_PRICING_PROJECTS_MONTHLY_AMOUNT=29
# HUMANO_PRICING_PROJECTS_YEARLY_AMOUNT=290
# After Payment Link: default circuit is payment_link (user + team at /pricing/checkout/complete). Opt-in legacy: register_first
HUMANO_PRICING_SIGNUP_COMPLETION=payment_link
# Stripe Dashboard → Payment Link → After payment → full URL to /pricing/checkout/complete?session_id={CHECKOUT_SESSION_ID}&category=assistant|business|mentor (category optional; use mentor for the Mentor plan link). Default plan slug when category omitted: HUMANO_PRICING_POST_CHECKOUT_PLAN_SLUG. Session retrieval uses platform STRIPE_* / Cashier only (not team Stripe from Settings).
# HUMANO_PRICING_POST_CHECKOUT_PLAN_SLUG=assistant
# Demo team module bundle after TeamDemoSeeder (assistant|hunter|business|mentor). Default: business.
HUMANO_PRICING_DEMO_TEAM_PLAN_SLUG=business
# Demo cPanel account for Hosting module (DemoHostingSeeder)
# DEMO_CPANEL_HOST=huginn.revisionalpha.cloud
# DEMO_CPANEL_USER=democpanel
# DEMO_CPANEL_PASSWORD=

CASHIER_CURRENCY=
CASHIER_CURRENCY_LOCALE=

# Token billing: USD provider cost per 1,000,000 tokens (after TOON), then markup.
# Display currency is converted with exchange_rate_histories / exchange_rates.
# HUMANO_TOKEN_PRICE_PER_MILLION=10
# HUMANO_TOKEN_MARKUP_PERCENT=50
# HUMANO_TOKEN_BILLING_CURRENCY=EUR

# Registration: mode (free | checkout | gate) + Stripe product = platform access (also default for /subscription/billing-info & checkout when no plan is passed)
#REGISTRATION_MODE=free
#REGISTRATION_STRIPE_PRODUCT_ID=prod_xxx
#REGISTRATION_MODE=checkout   → after /register, redirect to Stripe Checkout until paid
#REGISTRATION_MODE=gate       → billing screen, then Stripe; after pay → QR onboarding
# Comma-separated team IDs that skip the registration billing gate (e.g. seeded demo team). Example: 1 or 1,2
#REGISTRATION_DEMO_TEAM_IDS=1

# -----------------------------------------------------------------------------
# Twilio
# -----------------------------------------------------------------------------
# WhatsApp support number (e.g. 34722372858)
WHATSAPP_SUPPORT_NUMBER=

# /wapify: QR generado con chillerlan/php-qrcode. URL completa opcional; si vacío usa PHONE + TEXT (api.whatsapp.com).
# WAPIFY_WHATSAPP_LINK=https://api.whatsapp.com/send/?phone=34613194131&text=Hola!
WAPIFY_WHATSAPP_LINK=
# Por defecto 34613194131 si no defines otra cosa
WAPIFY_WHATSAPP_PHONE=34613194131
WAPIFY_WHATSAPP_TEXT="Quiero probar el asistente"

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_DEFAULT_TEMPLATE=customer_support

# WhatsApp: twilio OR local (Baileys / Node.js with QR). This project often uses local.
WHATSAPP_DRIVER=local
WHATSAPP_LOCAL_BASE_URL=http://localhost:3000
WHATSAPP_LOCAL_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Google (OAuth, Analytics, Places)
# -----------------------------------------------------------------------------
# OAuth (People/Calendar): Google Cloud → Credentials → OAuth client → Authorized redirect URIs must
# include this exact URL (Google does not allow *.test TLDs there).
# With `php artisan serve` (default port 8000): set APP_URL=http://127.0.0.1:8000, open the app at that
# same URL in the browser, and register http://127.0.0.1:8000/integrations/google/callback (or use
# http://localhost:8000 consistently for APP_URL + browser + Google Console).
# Optional: full redirect URI if it must differ from {APP_URL}/integrations/google/callback (same host as the browser).
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES="openid,email,profile,https://www.googleapis.com/auth/contacts,https://www.googleapis.com/auth/calendar.events"

# WebDAV / CardDAV / CalDAV (same token as DAV_API_TOKEN in the webdav project)
WEBDAV_BASE_URL=https://webdav.test
WEBDAV_API_TOKEN=

# Google Analytics: Measurement ID (e.g. G-XXXXXXXXXX) for frontend
GOOGLE_ANALYTICS_ID=

# Google Places API (Places API New, for business search)
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# OVH
# -----------------------------------------------------------------------------
OVH_API_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_ENTERPRISE_ID=1

# -----------------------------------------------------------------------------
# AI (Claude API + Assistant Tooling)
# -----------------------------------------------------------------------------
# Tool assistant (WhatsApp + API): team flows from module_prompts (section_key → routing key with module).
# Per-team: Team Settings → Chat / Asistente → "Enrutado automático por palabras clave" (not .env). Default off = LLM + commit_assistant_flow.
# ASSISTANT_TOOL_INTENT_PROMPTS=true
# ASSISTANT_TOOL_INTENT_PROMPTS_MIN_SCORE=1

# -----------------------------------------------------------------------------
# Anthropic (Claude API)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=30
# Optional: custom system prompt (empty = use storage/app/claude_prompts/default.txt)
ANTHROPIC_SYSTEM_PROMPT=

# Budget spec AI generation (dimension/times/resources/tasks). Default 180s.
AI_BUDGET_SPEC_TIMEOUT=180

# AI failover: comma-separated providers used when the primary (Anthropic) is
# overloaded or rate limited (e.g. "openai,gemini"). Empty = no failover.
AI_ASSISTANT_FAILOVER=

# Task-based AI routing (App\Support\AiTasks). Primary provider for all AI tasks
# and the failover chain used when it is overloaded/rate limited. Requires the
# fallback provider's API key (e.g. OPENAI_API_KEY). Set AI_TASKS_FAILOVER= (empty)
# to disable failover.
AI_DEFAULT_TASK_PROVIDER=anthropic
AI_TASKS_FAILOVER=openai

# -----------------------------------------------------------------------------
# OpenAI (text/audio/embeddings depending on your usage)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs (audio; used by the 'eleven' AI provider)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# CurrencyFreaks
# -----------------------------------------------------------------------------
# Latest: php artisan exchange-rates:fetch
# Monthly history (historical API; paid plan may be required): php artisan exchange-rates:backfill-monthly --from=2000-01
# Monthly USD/ARS official (free BCRA API): php artisan exchange-rates:backfill-bcra --from=2011-01
# Monthly USD/EUR (free Frankfurter/ECB API): php artisan exchange-rates:backfill-frankfurter --from=2000-01
# Daily USD/ARS + USD/EUR: php artisan exchange-rates:fetch-daily
CURRENCYFREAKS_API_KEY=
CURRENCYFREAKS_BASE_CURRENCY=USD
CURRENCYFREAKS_TARGET_CURRENCIES=ARS,EUR

# -----------------------------------------------------------------------------
# MCP
# -----------------------------------------------------------------------------
MCP_ENABLED=false
MCP_ENDPOINT=http://localhost:3000/mcp

# -----------------------------------------------------------------------------
# WooCommerce (optional)
# -----------------------------------------------------------------------------
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# -----------------------------------------------------------------------------
# Postmark (optional)
# -----------------------------------------------------------------------------
POSTMARK_TOKEN=

# -----------------------------------------------------------------------------
# Landing widget / Mobile app (same env names as Mobile)
# -----------------------------------------------------------------------------
TEAM_TOKEN=
API_BASE_URL=https://humano.test
LANDING_PROMPT_NAME=landing
# Optional: redirect after "profundizar" form success
LANDING_SUCCESS_URL=

# Default category ID for new contacts/leads (same as Mobile; empty = disable)
DEFAULT_CATEGORY_ID=414
# DEFAULT_CONTACT_CATEGORY_ID=

# Optional fallback if a frontend does not send X-Team-Token
# PROJECTS_FUNNEL_TEAM_ID=

# -----------------------------------------------------------------------------
# VeriFactu (AEAT / Spain e-invoicing)
# -----------------------------------------------------------------------------
VERIFACTU_ENABLED=true
VERIFACTU_CURRENCY=EUR
VERIFACTU_ISSUER_NAME=
VERIFACTU_ISSUER_VAT=
VERIFACTU_CERT_PATH=
VERIFACTU_CERT_PASSWORD=
VERIFACTU_PRODUCTION=false
VERIFACTU_LOAD_MIGRATIONS=false

# -----------------------------------------------------------------------------
# Sentry
# -----------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=
# SENTRY_SAMPLE_RATE=
# SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_PROFILES_SAMPLE_RATE=
# SENTRY_ENABLE_LOGS=false
# SENTRY_LOG_LEVEL=
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_BREADCRUMBS_*=
# SENTRY_TRACE_*=

# -----------------------------------------------------------------------------
# Telescope
# -----------------------------------------------------------------------------
TELESCOPE_ENABLED=false
# TELESCOPE_DOMAIN=
# TELESCOPE_PATH=telescope
# TELESCOPE_DRIVER=database

# -----------------------------------------------------------------------------
# Sanctum
# -----------------------------------------------------------------------------
# Comma-separated list of stateful domains for SPA auth
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,localhost:3002,localhost:3003,localhost:3004,localhost:3005,localhost:3006,127.0.0.1

# Idoneo Ads SPA (OAuth return after connecting ad platforms)
# PAID_ADS_SPA_URL=http://localhost:3003
# Idoneo SPA origins allowed for password-reset links (POST /api/auth/forgot-password)
# ASSISTANT_APP_URL=https://idoneo-assistant.test
# MAILER_APP_URL=https://idoneo-mailer.test
# AFFILIATES_APP_URL=https://idoneo-affiliates.test
# ADS_APP_URL=https://idoneo-ads.test
# PROJECTS_APP_URL=https://idoneo-projects.test
# SANCTUM_TOKEN_PREFIX=

# -----------------------------------------------------------------------------
# Media library
# -----------------------------------------------------------------------------
MEDIA_DISK=public
# MEDIA_QUEUE=
# QUEUE_CONVERSIONS_BY_DEFAULT=true
# QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true

# -----------------------------------------------------------------------------
# Shopping cart
# -----------------------------------------------------------------------------
# SHOPPING_FORMAT_VALUES=false
# SHOPPING_DECIMALS=0
# SHOPPING_DEC_POINT=.
# SHOPPING_THOUSANDS_SEP=,

# -----------------------------------------------------------------------------
# View (compiled path; rarely needed)
# -----------------------------------------------------------------------------
# VIEW_COMPILED_PATH=

# -----------------------------------------------------------------------------
# Custom application
# -----------------------------------------------------------------------------
APP_VERSION=
ASSET_URL=

# -----------------------------------------------------------------------------
# Apollo.io
# -----------------------------------------------------------------------------
# API key (sales intelligence; create at https://app.apollo.io, API Settings)
APOLLO_API_KEY=

# -----------------------------------------------------------------------------
# Prospection
# -----------------------------------------------------------------------------
# Prospect Search landing: team that receives leads as contacts (status_id = 3 Convertido)
PROSPECT_SEARCH_TEAM_ID=
# URL of the Prospection frontend (React app). Email access link will point here (e.g. https://prospection.test).
PROSPECT_ACCESS_BASE_URL=
# Stripe Price ID for Prospection export (one-time payment). Must be an *active* price in Stripe (price_xxx).
# Used when no product in subscription_products has category=prospecting; else set there or in Prospection .env.
# PROSPECT_EXPORT_STRIPE_PRICE_ID=price_xxx
# Optional: display name and description for the Prospection card on the subscription page.
# PROSPECT_EXPORT_NAME=Prospection
# PROSPECT_EXPORT_DESCRIPTION=Exporta tus resultados de búsqueda de prospectos y descarga el CSV con los contactos.

# -----------------------------------------------------------------------------
# Laravel Boost (MCP / Cursor)
# -----------------------------------------------------------------------------
# BOOST_ENABLED=true
# Browser console → /_boost/browser-logs (for AI agents). Off by default in config/boost.php.
# Set true only when debugging with Laravel Boost browser-logs tool.
# BOOST_BROWSER_LOGS_WATCHER=true
