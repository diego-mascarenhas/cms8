APP_NAME=Humano
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=
APP_LOCALE=es_ES
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

DEBUGBAR_ENABLED=false

# Guest "/" redirect: set PUBLIC_HOME_ROUTE (named route) or PUBLIC_HOME_PATH (internal path). Empty = login.
# Examples: PUBLIC_HOME_ROUTE=landing | PUBLIC_HOME_ROUTE=wapify | PUBLIC_HOME_PATH=/landing
PUBLIC_HOME_ROUTE=
PUBLIC_HOME_PATH=

# Optional: custom logo paths (defaults under public/assets/)

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
SHOW_CONSOLE_OUTPUT=true


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# DB HUMANO SCHEME

# Production read-only connection (local only). Set ALLOW_PROD_READ_TOGGLE=true to show the navbar switch.
# Use a DB user with SELECT-only on production. Never enable ALLOW_PROD_READ_TOGGLE outside local.
ALLOW_PROD_READ_TOGGLE=
DB_PROD_READ_CONNECTION=
DB_PROD_READ_HOST=
DB_PROD_READ_PORT=
DB_PROD_READ_DATABASE=
DB_PROD_READ_USERNAME=
DB_PROD_READ_PASSWORD=
DB_PROD_READ_SCHEMA=
DB_PROD_READ_SSLMODE=

FORGE_SSH_HOST=
FORGE_SSH_USER=
FORGE_SITE_PATH=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


MAIL_MAILER=smtp
MAIL_HOST=relay.outboundspamprotection.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


MAILBABY_ENABLED=false
MAILBABY_API_KEY=
MAILBABY_API_URL=https://api.mailbaby.net
MAILBABY_WEBHOOK_SECRET=
EMAIL_FALLBACK_TO_SMTP=true

IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

MAILBOX_DRIVER=log
MAILBOX_HOST=
MAILBOX_PORT=
MAILBOX_PROTOCOL=
MAILBOX_ENCRYPTION=
MAILBOX_VALIDATE_CERT=
MAILBOX_USERNAME=
MAILBOX_PASSWORD=
MAILBOX_TIMEOUT=
MAILBOX_DEFAULT_ACCOUNT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sandbox

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_DEFAULT_TEMPLATE=customer_support


# WhatsApp driver: twilio (default) or local (Baileys Node.js service with QR)
WHATSAPP_DRIVER=local
WHATSAPP_LOCAL_BASE_URL=http://localhost:3000
WHATSAPP_LOCAL_WEBHOOK_SECRET=

NOTIFICATION_EMAIL=

# HUMANO Test

# REVISION ALPHA Test
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# REVISION ALPHA
STRIPE_WEBHOOK_TOLERANCE=300

# Optional: per-category Stripe accounts (mentoring, mailer, prospecting, hosting). If not set, STRIPE_KEY and STRIPE_SECRET above are used.
# All product/price IDs (Mailer, Prospecting, Mentoring, Hosting) are managed in subscription_products (admin UI). Sync with: php artisan products:sync [--category=mailer|prospecting|...] or php artisan products:sync --product-id=prod_xxx
#
# Lead URLs: /register/lead redirects to /register (free) or /register/checkout (Stripe) based on:
REGISTRATION_MODE=
REGISTRATION_STRIPE_PRODUCT_ID=


STRIPE_MAILER_BASIC=
STRIPE_MAILER_FOUNDATION=
STRIPE_MAILER_SCALE=

CASHIER_CURRENCY=
CASHIER_CURRENCY_LOCALE=

CURRENCYFREAKS_API_KEY=
CURRENCYFREAKS_BASE_CURRENCY=USD
CURRENCYFREAKS_TARGET_CURRENCIES=ARS,EUR


OVH_API_ENDPOINT=https://eu.api.ovh.com/1.0
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_ENTERPRISE_ID=1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GOOGLE_ANALYTICS_ID=
GOOGLE_PLACES_API_KEY=

GOOGLE_OAUTH_REDIRECT_URI=
APOLLO_API_KEY=

WHATSAPP_QR=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

WEBDAV_BASE_URL=https://webdav.test
WEBDAV_API_TOKEN=

CMS_GROUP=
CMS_TEAM_ID=

# Claude AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_TIMEOUT=30

ELEVENLABS_API_KEY=
OPENAI_API_KEY=

QUERY_DETECTOR_ENABLED=

# TEAM REVISION ALPHA (Local)
TEAM_TOKEN=
API_BASE_URL=https://humano.test
LANDING_PROMPT_NAME=landing
DEFAULT_CATEGORY_ID=414

PROSPECT_SEARCH_TEAM_ID=
PROSPECT_ACCESS_BASE_URL=
PROSPECT_EXPORT_STRIPE_PRICE_ID=


# Opcional: equipo al que copiar las claves desde .env (si no, usa el primer team)

BOOST_BROWSER_LOGS_WATCHER=

# Public projects funnel (idoneo-projects) — team IDONEO
PROJECTS_FUNNEL_TEAM_ID=

# Public quote preview on the estimator frontend
BUDGET_PREVIEW_BASE_URL=
