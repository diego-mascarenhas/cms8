; Forge / Supervisor — worker solo para importar prospectos de Apollo.
; No lo mezcles con default, mailer ni communications.
;
; Cola:
;   prospects — busca una página del filtro y encola un trabajo por contacto

[program:idoneo-queue-prospects]
directory=/home/forge/admin.idoneo.dev
command=php8.4 /home/forge/admin.idoneo.dev/artisan queue:work redis --queue=prospects --sleep=3 --tries=3 --timeout=180 --max-time=3600 --memory=256
process_name=%(program_name)s_%(process_num)02d
autostart=true
autorestart=true
user=forge
numprocs=1
startsecs=1
redirect_stderr=true
stdout_logfile=/home/forge/admin.idoneo.dev/storage/logs/queue-prospects.log
stdout_logfile_maxbytes=5MB
stdout_logfile_backups=3
stopwaitsecs=3600
stopsignal=SIGTERM
stopasgroup=true
killasgroup=true
