<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Tests MUST use a separate DB. If these are commented out, PHPUnit uses .env (MySQL) and RefreshDatabase wipes your dev data. tests/TestCase.php also fails fast if the default connection is not safe sqlite. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- An empty sender makes Symfony reject every message, so any code path that mails ends in a 500. -->
        <env name="MAIL_FROM_ADDRESS" value="testing@example.test"/>
        <env name="MAIL_FROM_NAME" value="Testing"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="ASSISTANT_AI_REQUIRES_PLAN" value="false"/>
        <!-- Empty so factory teams with id 1–3 are not treated as complimentary paid. -->
        <env name="CMS8_PLAN_ACCESS_TEAM_IDS" value=""/>
    </php>
</phpunit>
