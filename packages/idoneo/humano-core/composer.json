{
    "name": "idoneo/humano-core",
    "description": "Core functionality for Humano system - Basic framework, authentication, and foundation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Idoneo",
            "email": "contact@idoneo.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/jetstream": "^4.0",
        "livewire/livewire": "^3.0",
        "laravel/sanctum": "^3.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Idoneo\\HumanoCore\\": "src/",
            "Idoneo\\HumanoCore\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Idoneo\\HumanoCore\\Providers\\HumanoCoreServiceProvider"
            ],
            "aliases": {
                "HumanoCore": "Idoneo\\HumanoCore\\Facades\\HumanoCore"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
