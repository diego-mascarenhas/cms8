{
  "name": "laravel/laravel",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": [
    "laravel",
    "framework"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "barryvdh/laravel-debugbar": "^3.14",
    "beyondcode/laravel-mailbox": "*",
    "chillerlan/php-qrcode": "^5.0",
    "darryldecode/cart": "^4.2",
    "doctrine/dbal": "^3.5.1",
    "fakerphp/faker": "^1.23",
    "guzzlehttp/guzzle": "^7.9",
    "jd-dotlogics/laravel-grapesjs": "^3.4",
    "laravel/cashier": "^15.4",
    "laravel/framework": "^10.23",
    "laravel/jetstream": "^4.3",
    "laravel/sanctum": "^3.2",
    "laravel/tinker": "^2.8",
    "laravel/ui": "^4.2",
    "livewire/livewire": "^3.0",
    "mailgun/mailgun-php": "^4.3",
    "nyholm/psr7": "^1.8",
    "sendgrid/sendgrid": "^8.1",
    "spatie/laravel-activitylog": "^4.10",
    "spatie/laravel-medialibrary": "^11.13",
    "spatie/laravel-permission": "^6.20",
    "spatie/simple-excel": "^3.6",
    "symfony/http-client": "^7.3",
    "symfony/mailgun-mailer": "^7.1",
    "tijsverkoyen/css-to-inline-styles": "^2.3",
    "twilio/sdk": "^8.2",
    "webklex/php-imap": "*",
    "yajra/laravel-datatables": "^10.1",
    "yajra/laravel-datatables-oracle": "^10.11",
    "zbateson/mail-mime-parser": "^2.4"
  },
  "require-dev": {
    "laravel-lang/common": "^6.4",
    "laravel/pint": "^1.22",
    "laravel/sail": "^1.25",
    "mockery/mockery": "^1.4.4",
    "nunomaduro/collision": "^7.0",
    "phpunit/phpunit": "^10.1",
    "pixinvent/vuexy-laravel-bootstrap-jetstream": "dev-mix",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    },
    "files": [
      "app/Helpers/Helpers.php",
      "app/Helpers/FileHelpers.php",
      "app/Helpers/WHMHelper.php",
      "app/Helpers/ActivityHelper.php",
      "app/Helpers/TranslationHelper.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
