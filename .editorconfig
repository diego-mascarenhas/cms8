root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = tab
indent_size = 4

[*.blade.php]
indent_style = tab
indent_size = 4

[*.js]
indent_style = tab
indent_size = 4

[*.css]
indent_style = tab
indent_size = 4

[*.scss]
indent_style = tab
indent_size = 4

[*.json]
indent_style = tab
indent_size = 4

[*.yml]
indent_style = tab
indent_size = 4

[*.yaml]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = tab
indent_size = 2

[package.json]
indent_style = tab
indent_size = 2

[composer.json]
indent_style = tab
tab_width = 4
